# Browser-safe Supabase connection values
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Server-only. Required only for Super Admin invitations and user administration.
SUPABASE_SECRET_KEY=sb_secret_your_key

# Public canonical origin. Build the Domainesia package with the final subdomain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional official consultation calendar. Omit until ownership is confirmed.
NEXT_PUBLIC_CALENDAR_APPOINTMENT_URL=

# Explicit local/preview sandbox. Leave false when Supabase is configured.
# Generate the session secret outside the repository: openssl rand -base64 32
ADMIN_DEMO_MODE=false
ADMIN_DEMO_SESSION_SECRET=replace-with-at-least-32-random-characters
